# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_BUCKET=trador-ai-data
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Helius RPC
# Rate Limits by Plan:
# FREE: 10 RPS, 100k credits/day
# DEVELOPER: 50 RPS, 500k credits/day
# BUSINESS: 200 RPS, 2M credits/day
# PROFESSIONAL: 500 RPS, 5M credits/day
HELIUS_API_KEY=your-helius-api-key
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-helius-api-key
HELIUS_PLAN=free

# Solana Wallet (for live trading - leave empty for virtual only)
PRIVATE_KEY=

# Dashboard
DASHBOARD_PORT=3002
API_PORT=3003

# GPU Settings (for Google Cloud VM with L4)
USE_GPU=true
GPU_WORKERS=4

# AI Settings
MIN_CONFIDENCE_FOR_VIRTUAL=60
MIN_CONFIDENCE_FOR_LIVE=85
