# Solana RPC (use dedicated for production - Helius, QuickNode, etc)
RPC_URL=https://api.mainnet-beta.solana.com

# Wallet private key (base58 encoded)
PRIVATE_KEY=your_private_key_here

# TRADOR token mint address (for buybacks)
TRADOR_MINT=your_trador_mint_here

# Reserve SOL (never trade below this)
MIN_SOL_RESERVE=0.5

# Scan interval (ms) - how often to look for trades
SCAN_INTERVAL=5000

# Dashboard API port
DASHBOARD_PORT=3001

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
